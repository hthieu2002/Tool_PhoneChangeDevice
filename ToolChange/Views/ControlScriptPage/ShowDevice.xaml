<Window x:Class="ToolChange.Views.ControlScriptPage.ShowDevice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windowsForms="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="View Device ID:"
        Height="500"
        Width="400"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border CornerRadius="0,0,0,0"
            Background="Transparent"
            BorderBrush="Gray"
            BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="23.6"
                                  x:Name="MainColumn" />
                <ColumnDefinition Width="226.4" />
                <ColumnDefinition Width="150"
                                  x:Name="MenuColumn" />
            </Grid.ColumnDefinitions>

            <!-- Main Content Column -->
            <Grid Grid.Column="0"
                  Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="465" />
                </Grid.RowDefinitions>

                <Grid Background="#FFB2B2B2">
                    <Label 
                           x:Name="logDevice"
                           FontSize="13"
                           HorizontalContentAlignment="Left"
                           VerticalContentAlignment="Center"
                           Foreground="Red"
                           Margin="5,0,5,0" />
                    <StackPanel Orientation="Horizontal"
                                Grid.Row="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Margin="0">
                        <Button Content="🔄"
                                Width="30"
                                Height="30"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="LoadButton_Click"
                                Background="#FF008CBA"
                                Margin="0,0,5,0" />

                        <Button Content="✖"
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Padding="0"
                                Margin="0,0,5,0"
                                Click="CloseButton_Click"
                                Background="#FFF32121" />

                        <Button Content="⏩"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Margin="0,0,5,0"
                                Click="ToggleMenu_Click" />


                    </StackPanel>

                </Grid>
                <Border Cursor="Hand"
                        Grid.Row="1">
                    <windowsForms:WindowsFormsHost x:Name="ScrcpyHostView"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   Cursor="Hand" />
                </Border>
            </Grid>

            <!-- Menu Panel Column -->
            <Border Grid.Column="2"
                    CornerRadius="0,0,0,0"
                    Background="#DCDCDC">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <Label Content="DeviceID"
                           Grid.Row="0"
                           FontSize="13"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           x:Name="deviceID" />

                    <StackPanel Orientation="Vertical"
                                Grid.Row="1"
                                Background="#D3D3D3"
                                Margin="0,10,0,0"
                                VerticalAlignment="Top">

                        <Button Click="StartDevice_Click"
                                Margin="0,5"
                                Padding="5"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀"
                                           FontSize="18"
                                           Foreground="#007ACC"
                                           Margin="0,0,5,0" />
                                <TextBlock Text="Khởi động thiết bị"
                                           FontSize="13"
                                           Foreground="#007ACC" />
                            </StackPanel>
                        </Button>

                        <Button Click="InstallApk_Click"
                                Margin="0,5"
                                Padding="5"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦"
                                           FontSize="18"
                                           Foreground="#007ACC"
                                           Margin="0,0,5,0" />
                                <TextBlock Text="Cài đặt APK"
                                           FontSize="13"
                                           Foreground="#007ACC" />
                            </StackPanel>
                        </Button>

                        <Button Click="AdbCommand_Click"
                                Margin="0,5"
                                Padding="5"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💻"
                                           FontSize="18"
                                           Foreground="#007ACC"
                                           Margin="0,0,5,0" />
                                <TextBlock Text="Lệnh ADB"
                                           FontSize="13"
                                           Foreground="#007ACC" />
                            </StackPanel>
                        </Button>

                        <Button Click="FakeProxy_Click"
                                Margin="0,5"
                                Padding="5"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕵️‍♂️"
                                           FontSize="18"
                                           Foreground="#007ACC"
                                           Margin="0,0,5,0" />
                                <TextBlock Text="Fake Proxy"
                                           FontSize="13"
                                           Foreground="#007ACC" />
                            </StackPanel>
                        </Button>

                        <Button Click="Wifi_Click"
                                Margin="0,5"
                                Padding="5"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📶"
                                           FontSize="18"
                                           Foreground="#007ACC"
                                           Margin="0,0,5,0" />
                                <TextBlock Text="Wifi"
                                           x:Name="wifiSetting"
                                           FontSize="13"
                                           Foreground="#007ACC" />
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <UniformGrid Grid.Row="2"
                                 Columns="3"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center">
                        <Button Content="⬜"
                                FontSize="23"
                                Foreground="#FF4F9AC9"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="Button_Click_2" />

                        <Button Content="⚪"
                                FontSize="17"
                                Foreground="#FF4F9AC9"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="Button_Click_1" />

                        <Button Content="◀"
                                FontSize="17"
                                Foreground="#FF4F9AC9"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="Button_Click" />
                    </UniformGrid>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

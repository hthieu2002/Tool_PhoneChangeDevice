<Window x:Class="ToolChange.Views.ControlScriptPage.FakeProxyID"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ToolChange.Views.ControlScriptPage"
        mc:Ignorable="d"
        Background="#F5F5F5"
        Title="FakeProxyID"
        ResizeMode="NoResize"
        Height="400"
        Width="600">
    <Grid Margin="15">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label x:Name="titleProxy"
               HorizontalAlignment="Center"
               VerticalContentAlignment="Center"
               Content="Fake proxy"
               FontSize="18"
               FontWeight="Bold"
               Grid.Column="1"
               Margin="0,0,0,0" />
        <Grid Margin="10,10,10,10"
              Grid.Row="1"
              Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ô nhập Host -->
            <Grid Margin="15,10,30,5"
                  Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <Border CornerRadius="8"
                        Padding="4"
                        Background="#F5F5F5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush"
                                    Value="Gray" />
                            <Setter Property="BorderThickness"
                                    Value="1.5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}"
                                             Value="True">
                                    <Setter Property="BorderBrush"
                                            Value="LimeGreen" />
                                    <Setter Property="BorderThickness"
                                            Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox materialDesign:HintAssist.Hint="Host"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                             Background="Transparent"
                             BorderThickness="0"
                             Text="{Binding ProxyHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="HostTextBox_PreviewKeyDown"
                             Padding="10,4,4,4"
                             VerticalContentAlignment="Center" />
                </Border>

                <Border CornerRadius="8"
                        Grid.Row="2"
                        Padding="4"
                        Background="#F5F5F5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush"
                                    Value="Gray" />
                            <Setter Property="BorderThickness"
                                    Value="1.5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}"
                                             Value="True">
                                    <Setter Property="BorderBrush"
                                            Value="LimeGreen" />
                                    <Setter Property="BorderThickness"
                                            Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox materialDesign:HintAssist.Hint="User name"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                             x:Name="UsernameTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Text="{Binding ProxyUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,4,4,4"
                             VerticalContentAlignment="Center" />
                </Border>
            </Grid>

            <Grid Margin="15,10,30,5"
                  Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Border CornerRadius="8"
                        Padding="4"
                        Background="#F5F5F5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush"
                                    Value="Gray" />
                            <Setter Property="BorderThickness"
                                    Value="1.5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}"
                                             Value="True">
                                    <Setter Property="BorderBrush"
                                            Value="LimeGreen" />
                                    <Setter Property="BorderThickness"
                                            Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox materialDesign:HintAssist.Hint="Port"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                             x:Name="PortTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10,4,4,4"
                             Text="{Binding ProxyPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" />
                </Border>

                <Border CornerRadius="8"
                        Grid.Row="2"
                        Padding="4"
                        Background="#F5F5F5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush"
                                    Value="Gray" />
                            <Setter Property="BorderThickness"
                                    Value="1.5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}"
                                             Value="True">
                                    <Setter Property="BorderBrush"
                                            Value="LimeGreen" />
                                    <Setter Property="BorderThickness"
                                            Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox materialDesign:HintAssist.Hint="Password"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                             Background="Transparent"
                             x:Name="PasswordTextBox"
                             BorderThickness="0"
                             Text="{Binding ProxyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,4,4,4"
                             VerticalContentAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2"
              Grid.ColumnSpan="2">
            <Separator Margin="0,10"
                       Width="150" />

        </Grid>
        <Grid Margin="5,5,5,5"
              Grid.Row="3"
              Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Label Content="Loại proxy"
                       FontSize="14"
                       Margin="20,5" />
                <Label Content="Thiết bị"
                       FontSize="14"
                       Margin="20,5"
                       Grid.Row="2" />
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Border BorderBrush="Gray"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Margin="0,0,40,0"
                        Background="#F5F5F5"
                        Padding="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <TextBox materialDesign:HintAssist.Hint="Proxy"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                             Background="Transparent"
                             BorderThickness="0"
                             x:Name="proxy"
                             IsReadOnly="True"
                             Padding="10,4,4,4"
                             VerticalContentAlignment="Center" />
                </Border>

                <Border BorderBrush="Gray"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Margin="0,0,40,0"
                        Background="#F5F5F5"
                        Grid.Row="2"
                        Padding="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                    <TextBox materialDesign:HintAssist.Hint="Device"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             x:Name="device"
                             Padding="10,4,4,4"
                             VerticalContentAlignment="Center" />
                </Border>
            </Grid>
        </Grid>

        <Button Width="140"
                Height="35"
                Margin="30,20,30,0"
                Grid.Row="5"
                Command="{Binding OKCommand}"
                Padding="10,4"
                Grid.Column="1">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="InternetProtocol"
                                         Width="20"
                                         Margin="0,0,8,0" />
                <TextBlock Text="Fake"
                           x:Name="BtnFake" />
            </StackPanel>
        </Button>

    </Grid>
</Window>

<Window x:Class="ToolChange.Views.ControlScriptPage.ListAppPackage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ToolChange.Views.ControlScriptPage"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="ListAppPackage"
        ResizeMode="NoResize"
        Height="350"
        Width="600">
    <Grid  Background="#C0C0C0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Grid  Background="#C0C0C0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Danh sách A -->
            <ListBox Grid.Column="0"
                     Background="#C0C0C0"
                     ItemsSource="{Binding ListA}" >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Margin="5,0,5,0"
                                    ToolTip="{Binding Package}"
                                    Background="#A9A9A9	">
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Margin="5"
                                       Width="180" />
                            <Button Content="+"
                                    Command="{Binding DataContext.MoveToBCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Width="25"
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="5"
                                    Padding="0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Icon chuyển giữa -->
            <Grid Grid.Column="1"
                  VerticalAlignment="Top"
                  Margin="0,50,0,0"
                  HorizontalAlignment="Center">
                <TextBlock Text="⇄"
                           FontSize="24" />
            </Grid>

            <!-- Danh sách B -->
            <ListBox Grid.Column="2"
                     Background="#C0C0C0"
                     HorizontalAlignment="Right"
                     ItemsSource="{Binding ListB}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    
                                    Margin="5,0,5,0"
                                    Background="#A9A9A9">
                          
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Margin="5,0,5,0"
                                       Width="180" />
                            <Button Content="-"
                                    Command="{Binding DataContext.MoveToACommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Width="25"
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="5"
                                    Padding="0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Button Width="80"
                Height="30"
                Grid.Row="1"
                Command="{Binding OKCommand}"
                Padding="4"
             >
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ListStatus"
                                         Width="20"
                                         Margin="0,0,8,0" />
                <TextBlock Text="OK"
                           x:Name="BtnOK" />
            </StackPanel>
        </Button>
    </Grid>
</Window>

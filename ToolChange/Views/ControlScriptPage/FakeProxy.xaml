<Window x:Class="ToolChange.Views.ControlScriptPage.FakeProxy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ToolChange.Views.ControlScriptPage"
        mc:Ignorable="d"
        Title="FakeProxy"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        Height="450"
        Width="782">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label x:Name="titleProxy"
                   HorizontalAlignment="Center"
                   VerticalContentAlignment="Center"
                   Content="Fake proxy"
                   FontSize="18"
                   FontWeight="Bold" />
            <Grid Margin="10"
                  Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Ô nhập Host -->
                <Grid Margin="15,10,30,5"
                      Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="Gray"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Background="#F5F5F5"
                            Padding="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBox materialDesign:HintAssist.Hint="Host"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 PreviewKeyDown="HostTextBox_PreviewKeyDown"
                                 Text="{Binding ProxyHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,4,4,4"
                                 VerticalContentAlignment="Center" />
                    </Border>

                    <Border BorderBrush="Gray"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Background="#F5F5F5"
                            Padding="4"
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBox materialDesign:HintAssist.Hint="User name"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                 Background="Transparent"
                                 Text="{Binding ProxyUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 x:Name="UsernameTextBox"
                                 Padding="10,4,4,4"
                                 VerticalContentAlignment="Center" />
                    </Border>
                </Grid>

                <Grid Margin="15,10,30,5"
                      Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="Gray"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Background="#F5F5F5"
                            Padding="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBox materialDesign:HintAssist.Hint="Port"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                 Background="Transparent"
                                 Text="{Binding ProxyPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 x:Name="PortTextBox"
                                 Padding="10,4,4,4"
                                 VerticalContentAlignment="Center" />
                    </Border>

                    <Border BorderBrush="Gray"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Background="#F5F5F5"
                            Padding="4"
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBox materialDesign:HintAssist.Hint="Password"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                 Background="Transparent"
                                 x:Name="PasswordTextBox"
                                 Text="{Binding ProxyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Padding="10,4,4,4"
                                 VerticalContentAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
            <Grid Grid.Row="2">
                <Separator Margin="0,10"
                           Width="150" />

            </Grid>
            <Grid Margin="5"
                  Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Label Content="Loại proxy"
                           FontSize="14"
                           Margin="20,5" />
                    <Label Content="Thiết bị"
                           FontSize="14"
                           Margin="20,5"
                           Grid.Row="2" />
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="Gray"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Margin="0,0,40,0"
                            Background="#F5F5F5"
                            Padding="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <ComboBox materialDesign:HintAssist.Hint="Proxy"
                                  materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                  materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="10,4,4,4"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding ProxyTypes}"
                                  SelectedItem="{Binding TypeProxy, Mode=TwoWay}" />

                    </Border>

                    <Border BorderBrush="Gray"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Margin="0,0,40,0"
                            Background="#F5F5F5"
                            Grid.Row="2"
                            Padding="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <ComboBox x:Name="DeviceComboBox"
                                  materialDesign:HintAssist.Hint="Device"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  ItemsSource="{Binding AllDevices}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="10,4,4,4"
                                  VerticalContentAlignment="Center"
                                  materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                  materialDesign:TextFieldAssist.UnderlineBrush="Transparent">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayLabel}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>


                    </Border>
                </Grid>
            </Grid>
            <CheckBox Content="Fake toàn bộ thiết bị"
                      Grid.Row="4"
                      IsChecked="{Binding DeviceALL, Mode=TwoWay}"
                      Margin="20,10" />
            <Button Width="100"
                    Height="35"
                    Grid.Row="5"
                    Command="{Binding OKCommand}"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InternetProtocol"
                                             Width="20"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="Fake" />
                </StackPanel>
            </Button>

        </Grid>
        <Rectangle Width="1"
                   Grid.Column="1"
                   Fill="Gray"
                   VerticalAlignment="Stretch"
                    />

        <Grid Grid.Column="2"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Content="Danh sách thiết bị"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   FontSize="14"
                   Margin="0,0,0,10" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
                <ItemsControl ItemsSource="{Binding SelectedDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="0,5"
                                    Padding="5"
                                    Background="#F5F5F5">
                                <DockPanel>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               ToolTip="{Binding DisplayLabel}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Width="110" />

                                    <Button Content="❌"
                                            FontSize="11"
                                            Padding="0"
                                            Width="25"
                                            Height="25"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Right"
                                            Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
  
</Window>
